---
import { site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <span>© {year} {site.name}</span>
    <span class="links">
      <a class="link-muted" href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <a class="link-muted" href={site.instagram} target="_blank" rel="noopener">Instagram</a>
    </span>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--line); margin-top: 96px; }
  .site-footer .wrap { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16px; padding: 24px 0; font-size: 12px; color: var(--muted); }
  .links { display: flex; gap: 24px; }
</style>
