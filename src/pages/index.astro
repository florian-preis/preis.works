---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import veil from '../../content/veil.json';
import { Content as About } from '../../content/about.md';
import portrait from '../assets/portrait.jpg';
import { site } from '../data/site';
import { photos } from '../data/photos';
import { fogName } from '../data/veil-names.mjs';

// Every photo can appear in the veil. The sharp layer reuses the lightbox size (same file as on
// the Photography page), and the fogged layer uses a tiny pre-blurred image. The browser only ever
// loads the photo on screen and the next one.
const focus = veil.focus as Record<string, string>;
const pool = await Promise.all(
  photos
    .filter((p) => !veil.exclude.includes(p.file))
    .map(async (p) => {
      const view = await getImage({ src: p.image, width: 2000, format: 'webp', quality: 80 });
      // l = landscape. Wide screens only show landscape photos, so little is lost to cropping.
      return { v: view.src, f: `/veil/${fogName(p.file)}`, o: focus[p.file] ?? '50% 50%', l: p.image.width >= p.image.height ? 1 : 0 };
    })
);
const hold = veil.secondsPerPhoto;
---
<Base active="about" navMode="veil">
  <!-- Veil: a fogged window over a slow slideshow, the name wiped clear with a finger -->
  <section slot="lead" class="veil" id="veil" data-tone={veil.tone} style={`--fade:2s;--drift:${hold + 2}s`} aria-labelledby="veil-name">
    <h1 id="veil-name" class="visually-hidden">Florian Preis</h1>

    <div class="layer fog" aria-hidden="true">
      <div class="slide"><img class="drift" alt=""></div>
      <div class="slide"><img class="drift" alt=""></div>
    </div>
    <div class="haze" aria-hidden="true"></div>
    <svg class="condensation" aria-hidden="true">
      <filter id="condensation"><feTurbulence type="fractalNoise" baseFrequency="1.4" numOctaves="2" stitchTiles="stitch"/><feColorMatrix type="saturate" values="0"/></filter>
      <rect width="100%" height="100%" filter="url(#condensation)"/>
    </svg>
    <div class="layer clear" aria-hidden="true">
      <div class="slide"><img class="drift" alt=""></div>
      <div class="slide"><img class="drift" alt=""></div>
    </div>

    <script is:inline type="application/json" id="veil-pool" set:html={JSON.stringify({ hold, pool })}></script>
    <script is:inline>
      // Runs while the page is still loading, so the first random photo is in place before anything paints.
      (function () {
        var cfg = JSON.parse(document.getElementById('veil-pool').textContent);
        // Wide screens: landscape photos only. Tall screens (phones): landscape and portrait.
        var tall = window.matchMedia('(orientation: portrait)').matches;
        var pool = cfg.pool.filter(function (p) { return tall || p.l; });
        if (!pool.length) pool = cfg.pool.slice();
        for (var i = pool.length - 1; i > 0; i--) { var j = Math.floor(Math.random() * (i + 1)); var t = pool[i]; pool[i] = pool[j]; pool[j] = t; }
        var veil = document.getElementById('veil');
        var fogSlides = veil.querySelectorAll('.fog .slide');
        var clearSlides = veil.querySelectorAll('.clear .slide');
        var still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var k = 0, slot = 0, timer = null, visible = true;

        function put(s, p) {
          [fogSlides[s], clearSlides[s]].forEach(function (el, layer) {
            var img = el.firstElementChild;
            img.src = layer === 0 ? p.f : p.v;
            img.style.objectPosition = p.o;
            img.classList.remove('go'); void img.offsetWidth; img.classList.add('go');
          });
        }
        function show(s) {
          [fogSlides, clearSlides].forEach(function (set) { set[s].classList.add('on'); set[1 - s].classList.remove('on'); });
        }
        function preload(p) { var a = new Image(); a.src = p.f; var b = new Image(); b.src = p.v; return b; }

        put(0, pool[0]); show(0);
        if (still || pool.length < 2) return;
        var next = preload(pool[1]);

        function advance() {
          if (!visible || document.hidden) return;
          k = (k + 1) % pool.length; slot = 1 - slot;
          var go = function () { put(slot, pool[k]); show(slot); next = preload(pool[(k + 1) % pool.length]); };
          next.complete ? go() : (next.onload = go, next.onerror = go);
        }
        timer = setInterval(advance, cfg.hold * 1000);
        // Pause while the veil is off screen
        new IntersectionObserver(function (e) { visible = e[0].isIntersecting; }).observe(veil);
      })();
    </script>
  </section>

  <main class="about wrap">
    <Image class="portrait" src={portrait} alt="Florian Preis" widths={[320, 640]} sizes="(max-width: 700px) 60vw, 320px" />
    <div class="about-text">
      <About />
      <ul class="contact">
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M2 7l10 7 10-7"/></svg>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </li>
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="2" width="12" height="20" rx="2"/><path d="M11 18h2"/></svg>
          <span class="phone" data-codes={site.phoneCodes.join(',')}></span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="3"/><path d="M7 10v7M7 7v.01M11 17v-4a2 2 0 014 0v4M11 10v7"/></svg>
          <a href={site.linkedin} target="_blank" rel="noopener">florianpreis</a>
        </li>
      </ul>
    </div>
  </main>
</Base>

<style>
  /* ── Veil ── */
  .veil { position: relative; height: 100vh; height: 100svh; min-height: 520px; overflow: hidden; background: #9a9994; --p: 0; }
  .layer { position: absolute; inset: 0; }
  .fog { inset: -40px; }
  .slide { position: absolute; inset: 0; overflow: hidden; opacity: 0; transition: opacity var(--fade) linear; }
  .slide.on { opacity: 1; }
  .drift { width: 100%; height: 100%; object-fit: cover; transform: scale(1); }
  /* One standard movement for every photo: it settles in from a slight zoom while it fades in,
     then holds still. Motion happens once, with intent, instead of a barely visible drift. */
  .drift.go { animation: veilSettle 4.5s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
  @keyframes veilSettle { from { transform: scale(1.12); } to { transform: scale(1); } }
  .haze { position: absolute; inset: 0; background: rgba(235, 235, 235, 0.42); }
  .condensation { position: absolute; inset: 0; width: 100%; height: 100%; mix-blend-mode: soft-light; opacity: 0.5; pointer-events: none; }
  /* The sharp photo shows only through the handwritten name and the smiley under it, and fogs over as you scroll away */
  .clear {
    -webkit-mask: url('/brand/name-smiley-mask.png') center / min(84vw, 1080px) auto no-repeat;
    mask: url('/brand/name-smiley-mask.png') center / min(84vw, 1080px) auto no-repeat;
    opacity: clamp(0, calc(1 - var(--p)), 1);
  }
  /* Tall screens: first name, last name, and the smiley on three lines, larger */
  @media (orientation: portrait) {
    .clear {
      -webkit-mask: url('/brand/name-smiley-mask-stacked.png') center / min(92vw, 660px) auto no-repeat;
      mask: url('/brand/name-smiley-mask-stacked.png') center / min(92vw, 660px) auto no-repeat;
    }
  }
  .veil[data-tone='muted'] .fog { filter: saturate(0.7); }
  .veil[data-tone='muted'] .clear .drift { filter: saturate(0.8); }
  .veil[data-tone='mono'] .fog, .veil[data-tone='mono'] .clear .drift { filter: grayscale(1) contrast(1.05); }
  @media (prefers-reduced-motion: reduce) { .drift.go { animation: none; } .slide { transition: none; } }

  /* ── Two resting places: the veil, and everything after it ──
     The block after the veil is at least as tall as the largest screen height (100vh is the
     height with the phone's browser bars hidden), so you can always scroll the veil fully out
     of view. Scrolling snaps to one place or the other; inside the block you scroll freely. */
  :global(html:has(#veil)) { scroll-snap-type: y mandatory; }
  .veil { scroll-snap-align: start; }
  :global(.after-lead) { min-height: max(100vh, 520px); display: flex; flex-direction: column; scroll-snap-align: start; }

  /* ── About ── */
  /* Top space: once the page snaps past the veil, the menu sits in it (72 px tall), so the portrait
     starts 48 px below the menu on computers and 32 px below it on phones */
  .about { display: flex; flex-wrap: wrap; gap: 72px; align-items: flex-start; padding-top: 120px; }
  .portrait { flex: 1 1 260px; max-width: 320px; height: auto; aspect-ratio: 2 / 3; object-fit: cover; object-position: top; border-radius: 16px; }
  .about-text { flex: 999 1 400px; min-width: 0; max-width: 62ch; line-height: 1.75; }
  .about-text :global(p) { margin: 0 0 18px; }
  .contact { list-style: none; margin: 32px 0 0; padding: 18px 0 0; border-top: 1px solid var(--line); display: flex; flex-direction: column; gap: 12px; font-size: 14px; }
  .contact li { display: flex; align-items: center; gap: 14px; min-height: 28px; }
  .contact svg { width: 16px; height: 16px; flex: none; fill: none; stroke: var(--faint); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .phone { min-width: 9em; }
  @media (max-width: 700px) {
    .about { gap: 32px; padding-top: 104px; }
    .portrait { max-width: 220px; }
  }
</style>

<script>
  // Fog returns over the name within the first quarter of the veil (at most 240 px of scrolling),
  // so it clears quickly on tall phone screens too. The menu arrives once the name is mostly
  // fogged and then stays for the rest of the visit; it only starts hidden again on a fresh load.
  const veil = document.getElementById('veil')!;
  const nav = document.querySelector<HTMLElement>('.nav-wrap');
  const fadeDistance = () => Math.min(veil.offsetHeight * 0.25, 240);
  let ticking = false;
  let arrived = false;
  const update = () => {
    ticking = false;
    const p = Math.min(Math.max(window.scrollY / fadeDistance(), 0), 1);
    veil.style.setProperty('--p', p.toFixed(3));
    if (!arrived && p >= 0.6) { arrived = true; nav?.classList.add('arrived'); }
  };
  window.addEventListener('scroll', () => {
    if (!ticking) { ticking = true; requestAnimationFrame(update); }
  }, { passive: true });
  update();

  // Phone number: never in the page source. It is stored as character codes and only written
  // into the page after the first sign of a person (scrolling, a touch, the mouse, or a key).
  // Most scrapers don't run scripts, and the few that do rarely scroll or move a mouse.
  const phone = document.querySelector<HTMLElement>('.phone');
  if (phone) {
    const human = ['scroll', 'wheel', 'pointermove', 'pointerdown', 'touchstart', 'keydown'];
    const show = () => {
      human.forEach((t) => window.removeEventListener(t, show));
      const d = phone.dataset.codes!.split(',').map((c) => String.fromCharCode(Number(c))).join('');
      const a = document.createElement('a');
      a.href = `tel:+${d}`;
      a.textContent = `+${d.slice(0, 2)} ${d.slice(2, 4)} ${d.slice(4, 6)} ${d.slice(6, 8)} ${d.slice(8)}`;
      phone.replaceChildren(a);
    };
    human.forEach((t) => window.addEventListener(t, show, { passive: true }));
  }
</script>
