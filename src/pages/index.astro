---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import veil from '../../content/veil.json';
import { Content as About } from '../../content/about.md';
import portrait from '../assets/portrait.jpg';
import portraitPersonal from '../assets/portrait-personal.jpg';
import { site } from '../data/site';
import { photos, viewOf } from '../data/photos';
import { fogName } from '../data/veil-names.mjs';

// Every photo can appear in the veil. The sharp layer reuses the lightbox size (same file as on
// the Photography page) on computers and tablets, and a smaller size on phones, where it only shows
// through the letters of the name. The fogged layer uses a tiny pre-blurred image. The browser only
// ever loads the photo on screen and the next one.
const focus = veil.focus as Record<string, string>;
const pool = await Promise.all(
  photos
    .filter((p) => !veil.exclude.includes(p.file))
    .map(async (p) => {
      const landscape = p.image.width >= p.image.height;
      const view = await viewOf(p);
      const small = await getImage(landscape
        ? { src: p.image, width: 1200, format: 'webp', quality: 80 }
        : { src: p.image, height: 1600, format: 'webp', quality: 80 });
      // v = sharp photo, s = the same for phones, f = fogged, o = crop point.
      // l = landscape. Wide screens only show landscape photos, so little is lost to cropping.
      return { v: view.src, s: small.src, f: `/veil/${fogName(p.file)}`, o: focus[p.file] ?? '50% 50%', l: landscape ? 1 : 0 };
    })
);
const hold = veil.secondsPerPhoto;

// A short machine-readable description of the site and of Florian for search engines and AI tools.
// It only repeats what the page already shows: name, portrait, email, and the two profiles.
const portraitUrl = new URL((await getImage({ src: portrait, width: 640, format: 'webp' })).src, Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': 'https://preis.works/#website', url: 'https://preis.works/', name: 'preis.works', inLanguage: 'en-GB', publisher: { '@id': 'https://preis.works/#florian' } },
    { '@type': 'ProfilePage', '@id': 'https://preis.works/#page', url: 'https://preis.works/', name: site.name, isPartOf: { '@id': 'https://preis.works/#website' }, mainEntity: { '@id': 'https://preis.works/#florian' } },
    {
      '@type': 'Person', '@id': 'https://preis.works/#florian',
      name: site.name, givenName: 'Florian', familyName: 'Preis',
      url: 'https://preis.works/', image: portraitUrl, email: `mailto:${site.email}`,
      description: site.description,
      sameAs: [site.linkedin, site.instagram],
    },
  ],
};
---
<Base active="about" navMode="veil">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <!-- Veil: a fogged window over a slow slideshow, the name wiped clear with a finger -->
  <section slot="lead" class="veil" id="veil" data-tone={veil.tone} style={`--fade:2s;--drift:${hold + 2}s`} aria-labelledby="veil-name">
    <h1 id="veil-name" class="visually-hidden">Florian Preis</h1>

    <div class="layer fog" aria-hidden="true">
      <div class="slide"><img class="drift" alt=""></div>
      <div class="slide"><img class="drift" alt=""></div>
    </div>
    <div class="haze" aria-hidden="true"></div>
    <div class="condensation" aria-hidden="true"></div>
    <div class="layer clear" aria-hidden="true">
      <div class="slide"><img class="drift" alt=""></div>
      <div class="slide"><img class="drift" alt=""></div>
    </div>

    <script is:inline type="application/json" id="veil-pool" set:html={JSON.stringify({ hold, pool })}></script>
    <script is:inline>
      // Runs while the page is still loading, so the first random photo is in place before anything paints.
      (function () {
        var cfg = JSON.parse(document.getElementById('veil-pool').textContent);
        // Wide screens: landscape photos only. Tall screens (phones): landscape and portrait.
        var tall = window.matchMedia('(orientation: portrait)').matches;
        // Phones load the smaller sharp photo
        var phone = window.matchMedia('(max-width: 700px)').matches;
        var pool = cfg.pool.filter(function (p) { return tall || p.l; });
        if (!pool.length) pool = cfg.pool.slice();
        for (var i = pool.length - 1; i > 0; i--) { var j = Math.floor(Math.random() * (i + 1)); var t = pool[i]; pool[i] = pool[j]; pool[j] = t; }
        var veil = document.getElementById('veil');
        var fogSlides = veil.querySelectorAll('.fog .slide');
        var clearSlides = veil.querySelectorAll('.clear .slide');
        var still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var k = 0, slot = 0, timer = null, visible = true;

        function put(s, p) {
          [fogSlides[s], clearSlides[s]].forEach(function (el, layer) {
            var img = el.firstElementChild;
            img.src = layer === 0 ? p.f : (phone ? p.s : p.v);
            img.style.objectPosition = p.o;
            img.classList.remove('go'); void img.offsetWidth; img.classList.add('go');
          });
        }
        function show(s) {
          [fogSlides, clearSlides].forEach(function (set) { set[s].classList.add('on'); set[1 - s].classList.remove('on'); });
        }
        function preload(p) { var a = new Image(); a.src = p.f; var b = new Image(); b.src = phone ? p.s : p.v; return b; }

        put(0, pool[0]); show(0);
        if (still || pool.length < 2) return;
        var next = preload(pool[1]);

        function advance() {
          if (!visible || document.hidden) return;
          k = (k + 1) % pool.length; slot = 1 - slot;
          var go = function () { put(slot, pool[k]); show(slot); next = preload(pool[(k + 1) % pool.length]); };
          next.complete ? go() : (next.onload = go, next.onerror = go);
        }
        timer = setInterval(advance, cfg.hold * 1000);
        // Pause while the veil is off screen
        new IntersectionObserver(function (e) { visible = e[0].isIntersecting; }).observe(veil);
      })();
    </script>
  </section>

  <main class="about wrap" id="main">
    <!-- Two portraits, professional by default. The personal one is kept at 640 × 960, the largest size
         the page shows, so no sharper copy exists on the site -->
    <div class="portrait-col">
      <div class="portrait" data-view="professional">
        <Image class="photo professional" src={portrait} alt="Florian Preis" widths={[320, 640]} sizes="(max-width: 700px) 60vw, 320px" />
        <Image class="photo personal" src={portraitPersonal} alt="Florian Preis, off duty" widths={[320, 640]} sizes="(max-width: 700px) 60vw, 320px" aria-hidden="true" />
      </div>
      <div class="switch portrait-switch">
        <button type="button" class="switch-label is-on" data-view="professional" aria-label="Professional photo">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="7" width="18" height="13" rx="2.5"/><path d="M9 7V5.5A1.5 1.5 0 0110.5 4h3A1.5 1.5 0 0115 5.5V7M3 12.5h18"/></svg>
        </button>
        <button type="button" class="switch-track" role="switch" aria-checked="false" aria-label="Personal photo"><span class="knob"></span></button>
        <button type="button" class="switch-label" data-view="personal" aria-label="Personal photo">
          <!-- The smiley from under the handwritten name, drawn as a line icon -->
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle class="dot" cx="8.6" cy="6.6" r="1.35"/><circle class="dot" cx="15" cy="6" r="1.35"/><path d="M4.3 13.4C4.6 16 6.6 18.6 10 19c3.6.4 7.3-2.2 9.8-5.7"/></svg>
        </button>
      </div>
    </div>
    <div class="about-text">
      <About />
      <ul class="contact">
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M2 7l10 7 10-7"/></svg>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </li>
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="2" width="12" height="20" rx="2"/><path d="M11 18h2"/></svg>
          <span class="phone" data-codes={site.phoneCodes.join(',')}></span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="3"/><path d="M7 10v7M7 7v.01M11 17v-4a2 2 0 014 0v4M11 10v7"/></svg>
          <a href={site.linkedin} target="_blank" rel="noopener">florianpreis</a>
        </li>
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><path d="M17.5 6.5v.01"/></svg>
          <a href={site.instagram} target="_blank" rel="noopener">florianprice</a>
        </li>
      </ul>
    </div>
  </main>
</Base>

<style>
  /* ── Veil ── */
  .veil { position: relative; height: 100vh; height: 100svh; min-height: 520px; overflow: hidden; background: #9a9994; --p: 0; }
  /* With scripts, the veil is a curtain lying over the About page, lifted and lowered by the script
     below (transform only, so it never repaints). Touches on it never scroll the page */
  :global(html.js) .veil { position: fixed; inset: 0; height: auto; min-height: 0; z-index: 40; touch-action: none; box-shadow: 0 10px 40px rgba(43, 43, 41, 0.14); }
  /* The soft shadow under the veil's lower edge shows while it moves, so it reads as a sheet lifting off the page */
  /* Lifted, the veil stays drawn just above the screen instead of being hidden, so bringing it back
     never has to redraw the photos, fog, and condensation first (that redraw made the return stutter) */
  .veil.lifted { pointer-events: none; }
  .layer { position: absolute; inset: 0; }
  .fog { inset: -40px; }
  .slide { position: absolute; inset: 0; overflow: hidden; opacity: 0; transition: opacity var(--fade) linear; }
  .slide.on { opacity: 1; }
  .drift { width: 100%; height: 100%; object-fit: cover; transform: scale(1); }
  /* One standard movement for every photo: it settles in from a slight zoom while it fades in,
     then holds still. Motion happens once, with intent, instead of a barely visible drift. */
  .drift.go { animation: veilSettle 4.5s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
  @keyframes veilSettle { from { transform: scale(1.12); } to { transform: scale(1); } }
  .haze { position: absolute; inset: 0; background: rgba(235, 235, 235, 0.42); }
  /* Condensation grain: a small tile of the same fine noise the veil used to compute live with an SVG
     filter (fractal noise, frequency 1.4, two octaves, grey), rendered once at twice the size and
     repeated. Phones drew the live filter slowly, which made the veil stutter whenever it came back */
  .condensation { position: absolute; inset: 0; background: url('/brand/condensation.webp') 0 0 / 160px 160px repeat; mix-blend-mode: soft-light; opacity: 0.5; pointer-events: none; }
  /* The sharp photo shows only through the handwritten name and the smiley under it, and fogs over as you scroll away */
  .clear {
    will-change: opacity;  /* its own layer: the fog over the name changes without redrawing the photo */
    -webkit-mask: url('/brand/name-smiley-mask.png') center / min(84vw, 1080px) auto no-repeat;
    mask: url('/brand/name-smiley-mask.png') center / min(84vw, 1080px) auto no-repeat;
    opacity: clamp(0, calc(1 - var(--p)), 1);
  }
  /* Tall screens: first name, last name, and the smiley on three lines, larger */
  @media (orientation: portrait) {
    .clear {
      -webkit-mask: url('/brand/name-smiley-mask-stacked.png') center / min(92vw, 660px) auto no-repeat;
      mask: url('/brand/name-smiley-mask-stacked.png') center / min(92vw, 660px) auto no-repeat;
    }
  }
  .veil[data-tone='muted'] .fog { filter: saturate(0.7); }
  .veil[data-tone='muted'] .clear .drift { filter: saturate(0.8); }
  .veil[data-tone='mono'] .fog, .veil[data-tone='mono'] .clear .drift { filter: grayscale(1) contrast(1.05); }
  @media (prefers-reduced-motion: reduce) { .drift.go { animation: none; } .slide { transition: none; } }
  /* Nudge ("peek"): if nobody scrolls, the veil lifts a little in one smooth motion, pauses, and slides
     back, showing a strip of the page underneath. Started from the script below. It moves the veil with
     `translate`, separate from the curtain's `transform`. The veil keeps its own compositing layer, so
     the movement never has to repaint the fog, mask, or condensation */
  .veil { --lift: 22px; will-change: transform; }
  .veil.nudge { animation: veilPeek 1.8s both; }
  @keyframes veilPeek {
    0%   { translate: 0 0; animation-timing-function: cubic-bezier(0.25, 0.7, 0.3, 1); }
    38%  { translate: 0 calc(-1 * var(--lift)); animation-timing-function: linear; }
    50%  { translate: 0 calc(-1 * var(--lift)); animation-timing-function: cubic-bezier(0.45, 0, 0.3, 1); }
    100% { translate: 0 0; }
  }
  @media (orientation: portrait) { .veil { --lift: 30px; } }

  /* ── The About page under the veil ──
     One block, footer included, at least as tall as the largest screen height, so on computers the
     footer sits at the bottom of the screen. It scrolls like any other page; the veil lies over it */
  :global(.after-lead) { min-height: max(100vh, 520px); display: flex; flex-direction: column; }
  /* With scripts, the profile is its own layer for good, so it can rise and fade in under the veil
     without being redrawn. The paper background keeps text as crisp as on the other pages */
  :global(html.js .after-lead) { will-change: transform, opacity; background: var(--paper); }

  /* ── About ── */
  /* Top space: once the veil has lifted, the menu sits in it (72 px tall), so the portrait
     starts 48 px below the menu on computers and 32 px below it on phones */
  .about { display: flex; flex-wrap: wrap; gap: 72px; align-items: flex-start; padding-top: 120px; }
  .portrait-col { flex: 1 1 260px; max-width: 320px; }
  .portrait { position: relative; aspect-ratio: 2 / 3; overflow: hidden; border-radius: 16px; background: var(--panel); }
  /* The personal photo lies on top of the professional one and fades in over it */
  .photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .personal { opacity: 0; transition: opacity var(--base) var(--ease); }
  .portrait[data-view='personal'] .personal { opacity: 1; }
  /* Switch: under the photo, the same switch as on Photography with icons instead of words. The
     briefcase lines up with the photo's left edge. Only shown when scripts run, since it does nothing without them */
  .portrait-switch { margin: 6px 0 0 -2px; }
  :global(html:not(.js)) .portrait-switch { display: none; }
  @media (prefers-reduced-motion: reduce) { .personal { transition: none; } }
  .about-text { flex: 999 1 400px; min-width: 0; max-width: 62ch; line-height: 1.75; }
  .about-text :global(p) { margin: 0 0 18px; }
  /* Links in the about text: a fine underline that darkens on hover */
  .about-text :global(p a) { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; text-decoration-color: var(--faint); transition: text-decoration-color var(--fast) ease; }
  @media (hover: hover) { .about-text :global(p a:hover) { text-decoration-color: var(--text); } }
  .contact { list-style: none; margin: 32px 0 0; padding: 18px 0 0; border-top: 1px solid var(--line); display: flex; flex-direction: column; gap: 12px; font-size: 14px; }
  /* Computers: two columns, email and phone on the left, LinkedIn and Instagram on the right */
  @media (min-width: 701px) {
    .contact { display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: auto auto; grid-auto-flow: column; column-gap: 24px; row-gap: 12px; }
  }
  .contact li { display: flex; align-items: center; gap: 14px; min-height: 28px; }
  .contact svg { width: 16px; height: 16px; flex: none; fill: none; stroke: var(--faint); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .phone { min-width: 9em; }
  /* Computers: once the veil has lifted, the profile and the footer fit on one screen.
     On shorter screens (most laptops) the photo gives way, down to 220 px wide, instead of the footer
     being cut off. 287 px is everything else in the photo's column: the space above it (120), the
     switch (50), the gap to the footer (48), and the footer (69). The text column needs about 650 px of
     screen height; below that it can't fit, and the page scrolls as usual */
  @media (min-width: 701px) {
    .portrait-col { max-width: clamp(220px, calc((100svh - 287px) * 2 / 3), 320px); }
    :global(.after-lead .site-footer) { margin-top: 48px; }
  }
  @media (max-width: 700px) {
    .about { gap: 32px; padding-top: 104px; }
    /* Phones: the switch sits beside the photo, level with its bottom edge, in the space that would
       otherwise stay empty. The photo gives way on the narrowest phones so the switch always fits */
    .portrait-col { flex-basis: 100%; max-width: none; display: flex; align-items: flex-end; }
    .portrait { flex: none; width: min(220px, calc(100% - 120px)); }
    .portrait-switch { margin: 0 0 -12px 12px; }
  }
</style>

<script>
  // ── Curtain: the veil lies over the About page and lifts off it ──
  // `lift` is how far the veil has lifted: 0 covers the screen, 1 is gone. On phones the veil follows
  // the finger and settles with a spring when you let go. With a mouse wheel, trackpad, or keys, a
  // small movement springs back and a deliberate one lifts the veil in one movement. At the very top
  // of the profile, the same gestures in the other direction bring it back. Everywhere else the
  // profile scrolls natively. As the veil lifts, the fog returns over the name (within a quarter of
  // the screen, at most 240 px), the profile rises into place, and the menu arrives.
  const veil = document.getElementById('veil')!;
  const lead = document.querySelector<HTMLElement>('.after-lead')!;
  const nav = document.querySelector<HTMLElement>('.nav-wrap');
  const menuToggle = document.querySelector<HTMLElement>('.nav-toggle');
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const RISE = 36;          // px the profile rises as it arrives
  const COMMIT = 0.12;      // share of the screen a drag must travel to switch ...
  const FLICK = 0.4;        // ... or the speed of a flick, in px per ms
  const WHEEL_COMMIT = 60;  // px of wheel movement that switches (one mouse-wheel notch is 100)
  const GAP = 180;          // ms without wheel events that ends a wheel gesture
  const SPRING = 9;         // spring frequency: settles in about 0.7 s, critically damped (no bounce)
  const H = () => window.innerHeight;
  const menuOpen = () => menuToggle?.getAttribute('aria-expanded') === 'true';
  const easeOut = (x: number) => 1 - Math.pow(1 - x, 3);

  let lift = 0;
  let speed = 0;                       // in lifts per second, while the spring runs
  let target: 0 | 1 | null = null;     // where the spring is heading, null when at rest or dragged
  let raf = 0;
  let going: 'up' | 'down' = 'up';

  // Each frame only changes what actually changed: the veil's position, the fog over the name, and
  // the profile's rise. All three are their own layers, so the browser moves them without redrawing
  const clear = veil.querySelector<HTMLElement>('.clear')!;
  let drawn = { veil: '', clear: '', rise: '', fade: '', arrived: false, fast: false, lifted: false };
  const paint = () => {
    const up = lift >= 1;
    const veilT = lift > 0 ? `translate3d(0, ${(-lift * 100).toFixed(2)}%, 0)` : '';
    const fog = Math.min(Math.max((lift * H()) / Math.min(H() * 0.25, 240), 0), 1);
    const clearO = (1 - fog).toFixed(3);
    const e = easeOut(lift);
    const rise = up ? '' : `translate3d(0, ${((1 - e) * RISE).toFixed(1)}px, 0)`;
    const fade = up ? '' : (0.35 + 0.65 * e).toFixed(3);
    // The menu arrives as the page settles, leaves as soon as the veil starts coming back,
    // and stays while the mobile menu is open
    const arrived = (lift >= 0.85 && !(going === 'down' && !up)) || menuOpen();
    const fast = going === 'down';
    if (veilT !== drawn.veil) veil.style.transform = drawn.veil = veilT;
    if (clearO !== drawn.clear) clear.style.opacity = drawn.clear = clearO;
    if (rise !== drawn.rise) lead.style.transform = drawn.rise = rise;
    if (fade !== drawn.fade) lead.style.opacity = drawn.fade = fade;
    if (up !== drawn.lifted) { drawn.lifted = up; veil.classList.toggle('lifted', up); }
    if (fast !== drawn.fast) nav?.classList.toggle('leave-fast', drawn.fast = fast);
    if (arrived !== drawn.arrived) nav?.classList.toggle('arrived', drawn.arrived = arrived);
  };

  const rest = () => {
    target = null;
    speed = 0;
    // Remembered for Back and Forward, so returning to Home lands where you left it
    history.replaceState({ ...(history.state || {}), veil: lift >= 1 ? 'lifted' : null }, '');
    if (lift >= 1) window.dispatchEvent(new Event('veillift'));
    else window.scrollTo(0, 0);
  };

  const settleTo = (to: 0 | 1, startSpeed = 0) => {
    cancelAnimationFrame(raf);
    target = to;
    going = to === 1 ? 'up' : 'down';
    speed = startSpeed;
    if (still) { lift = to; paint(); rest(); return; }
    let last = performance.now();
    const step = (now: number) => {
      const dt = Math.min(Math.max((now - last) / 1000, 0), 1 / 20);
      last = now;
      speed += (-SPRING * SPRING * (lift - to) - 2 * SPRING * speed) * dt;
      lift += speed * dt;
      // At rest once within a pixel and barely moving, or on reaching the end it heads for
      const done = (Math.abs(lift - to) * H() < 1 && Math.abs(speed) * H() < 30) || (to === 1 ? lift >= 1 : lift <= 0);
      lift = done ? to : lift;
      paint();
      if (done) rest(); else raf = requestAnimationFrame(step);
    };
    raf = requestAnimationFrame(step);
  };

  // A new gesture in the last few pixels of a movement finishes it at once, so the page under it
  // responds straight away instead of waiting for the spring's long, invisible tail
  const finishIfNearlyThere = () => {
    if (target !== null && Math.abs(lift - target) < 0.04) { cancelAnimationFrame(raf); lift = target; paint(); rest(); }
  };

  // Touch: drag the veil directly
  let touchMode: 'none' | 'drag' | 'native' = 'none';
  let touchY = 0;
  let touchFrom = 0;
  let lastY = 0;
  let lastTime = 0;
  let fingerSpeed = 0;  // px per ms, positive while the finger moves up
  let scrollAtStart = 0;
  window.addEventListener('touchstart', (e) => {
    touchMode = 'none';
    if (e.touches.length > 1 || menuOpen()) { touchMode = 'native'; return; }
    finishIfNearlyThere();
    touchY = lastY = e.touches[0].clientY;
    lastTime = e.timeStamp;
    fingerSpeed = 0;
    scrollAtStart = window.scrollY;
    // On the veil, or catching it mid-movement: take hold of it where it is
    if (lift < 1 || target !== null) { cancelAnimationFrame(raf); target = null; touchMode = 'drag'; touchFrom = lift; }
  }, { passive: true });
  window.addEventListener('touchmove', (e) => {
    if (touchMode === 'native' || e.touches.length > 1) return;
    const y = e.touches[0].clientY;
    if (touchMode === 'none') {
      // Profile: pulling down at the very top brings the veil back; anything else scrolls the page
      if (scrollAtStart <= 0 && window.scrollY <= 0 && y > touchY) { touchMode = 'drag'; touchFrom = 1; }
      else { touchMode = 'native'; return; }
    }
    if (e.cancelable) e.preventDefault();
    const dt = e.timeStamp - lastTime;
    if (dt > 0) fingerSpeed = 0.7 * ((lastY - y) / dt) + 0.3 * fingerSpeed;
    lastY = y;
    lastTime = e.timeStamp;
    going = fingerSpeed >= 0 ? 'up' : 'down';
    lift = Math.min(Math.max(touchFrom + (touchY - y) / H(), 0), 1);
    paint();
  }, { passive: false });
  const release = () => {
    if (touchMode !== 'drag') { touchMode = 'none'; return; }
    touchMode = 'none';
    // A finger that stopped before letting go has no speed left
    if (performance.now() - lastTime > 100 && Math.abs(fingerSpeed) > 0) fingerSpeed = 0;
    const moved = lift - touchFrom;
    let to: 0 | 1 = touchFrom >= 0.5 ? 1 : 0;
    if (fingerSpeed > FLICK) to = 1;
    else if (fingerSpeed < -FLICK) to = 0;
    else if (Math.abs(moved) > COMMIT) to = moved > 0 ? 1 : 0;
    settleTo(to, (fingerSpeed * 1000) / H());
  };
  window.addEventListener('touchend', release, { passive: true });
  window.addEventListener('touchcancel', release, { passive: true });

  // Mouse wheel and trackpad: the veil gives a little, then switches past the hurdle. A wheel gesture
  // that began further down the profile never brings the veil back, even when it reaches the top;
  // a new gesture at the top does. Movement left over after a switch (trackpad inertia) is absorbed.
  let wheelMode: 'drag' | 'absorb' | 'native' = 'native';
  let wheelSum = 0;
  let wheelFrom = 0;
  let lastWheel = 0;
  let wheelTimer = 0;
  window.addEventListener('wheel', (e) => {
    if (e.ctrlKey || menuOpen()) return;  // pinch to zoom on trackpads, or the menu is open
    const dy = e.deltaMode === 1 ? e.deltaY * 40 : e.deltaMode === 2 ? e.deltaY * H() : e.deltaY;
    const now = performance.now();
    if (now - lastWheel > GAP) {
      finishIfNearlyThere();
      wheelSum = 0;
      wheelFrom = lift >= 0.5 ? 1 : 0;
      if (target !== null) wheelMode = 'absorb';
      else if (lift < 1 || (window.scrollY <= 0 && dy < 0)) wheelMode = 'drag';
      else wheelMode = 'native';
    }
    lastWheel = now;
    if (wheelMode === 'native') return;
    e.preventDefault();
    if (wheelMode === 'absorb') return;
    wheelSum += dy;
    const along = wheelFrom === 0 ? wheelSum : -wheelSum;
    if (along >= WHEEL_COMMIT) { wheelMode = 'absorb'; settleTo(wheelFrom === 0 ? 1 : 0); return; }
    cancelAnimationFrame(raf);
    const give = (Math.max(along, 0) * 0.5) / H();
    lift = wheelFrom === 0 ? give : 1 - give;
    going = wheelFrom === 0 ? 'up' : 'down';
    paint();
    clearTimeout(wheelTimer);
    wheelTimer = window.setTimeout(() => { if (wheelMode === 'drag' && target === null && lift !== wheelFrom) settleTo(wheelFrom as 0 | 1); }, GAP);
  }, { passive: false });

  // Keys: Space, Page Down, the down arrow, or End lift the veil; at the top of the profile,
  // Page Up, the up arrow, or Home bring it back
  window.addEventListener('keydown', (e) => {
    if (e.defaultPrevented || e.altKey || e.ctrlKey || e.metaKey || menuOpen()) return;
    const el = e.target as HTMLElement;
    if (el.closest('input, textarea, select, [contenteditable]')) return;
    if (e.key === ' ' && el.closest('a, button')) return;
    const down = ['ArrowDown', 'PageDown', 'End'].includes(e.key) || (e.key === ' ' && !e.shiftKey);
    const up = ['ArrowUp', 'PageUp', 'Home'].includes(e.key) || (e.key === ' ' && e.shiftKey);
    if (down && lift < 1 && target !== 1) { e.preventDefault(); settleTo(1); }
    else if (up && lift >= 1 && target === null && window.scrollY <= 0) { e.preventDefault(); settleTo(0); }
  });

  // Keyboard focus moving into the profile (Tab, or the skip link), the scroll bar being dragged,
  // or a link to a place further down: the veil lifts
  lead.addEventListener('focusin', () => { if (lift < 1 && target !== 1) settleTo(1); });
  window.addEventListener('scroll', () => {
    if (window.scrollY > 0 && lift < 1 && target === null && touchMode !== 'drag') settleTo(1);
  }, { passive: true });
  window.addEventListener('resize', paint);

  // Start: covered, unless coming back to a page where the veil was already lifted
  lift = history.state?.veil === 'lifted' || window.scrollY > 0 || location.hash === '#main' ? 1 : 0;
  paint();

  // Nudge: if nobody has scrolled, touched, clicked, or pressed a key after two photos have gone by,
  // the veil peeks up a little (in the middle of the third photo, not during a change). It repeats
  // after every two more photos, three times at most, and stops for good at the first reaction.
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const hold = JSON.parse(document.getElementById('veil-pool')!.textContent!).hold as number;
    const reactions = ['scroll', 'wheel', 'touchstart', 'pointerdown', 'keydown'];
    let count = 0;
    let timer = 0;
    const stop = () => {
      clearTimeout(timer);
      reactions.forEach((t) => window.removeEventListener(t, stop));
      document.removeEventListener('visibilitychange', resume);
    };
    const nudge = () => {
      if (document.hidden || lift > 0 || target !== null) return;
      veil.classList.remove('nudge'); void veil.offsetWidth; veil.classList.add('nudge');
      if (++count < 3) timer = window.setTimeout(nudge, hold * 2 * 1000);
    };
    // A hidden tab pauses the photos, so the count starts over when you come back
    const resume = () => { clearTimeout(timer); if (!document.hidden && count < 3) timer = window.setTimeout(nudge, (hold * 2 + 4) * 1000); };
    reactions.forEach((t) => window.addEventListener(t, stop, { passive: true }));
    document.addEventListener('visibilitychange', resume);
    resume();
  }

  // Portrait switch: the professional photo by default, the personal one on request. Starts fresh on every visit.
  const portraitBox = document.querySelector<HTMLElement>('.portrait');
  const portraitSwitch = document.querySelector<HTMLElement>('.portrait-switch');
  if (portraitBox && portraitSwitch) {
    const track = portraitSwitch.querySelector<HTMLButtonElement>('.switch-track')!;
    const labels = Array.from(portraitSwitch.querySelectorAll<HTMLButtonElement>('.switch-label'));
    const photos = Array.from(portraitBox.querySelectorAll<HTMLImageElement>('.photo'));
    const setView = (view: 'professional' | 'personal') => {
      portraitBox.dataset.view = view;
      track.setAttribute('aria-checked', String(view === 'personal'));
      labels.forEach((l) => l.classList.toggle('is-on', l.dataset.view === view));
      // Screen readers only hear the photo that is showing
      photos.forEach((img) => img.toggleAttribute('aria-hidden', !img.classList.contains(view)));
    };
    track.addEventListener('click', () => setView(track.getAttribute('aria-checked') === 'true' ? 'professional' : 'personal'));
    labels.forEach((l) => l.addEventListener('click', () => setView(l.dataset.view as 'professional' | 'personal')));
  }

  // Phone number: never in the page source. It is stored as character codes and only written
  // into the page after the first sign of a person: lifting the veil (it sits under it, so everyone
  // lifts it to see it), scrolling, or a key. Not on a touch or click: on iPhones, a page change during a tap
  // can swallow that tap. Most scrapers don't run scripts, and the few that do rarely scroll.
  const phone = document.querySelector<HTMLElement>('.phone');
  if (phone) {
    const human = ['veillift', 'scroll', 'wheel', 'keydown'];
    const show = () => {
      human.forEach((t) => window.removeEventListener(t, show));
      const d = phone.dataset.codes!.split(',').map((c) => String.fromCharCode(Number(c))).join('');
      const a = document.createElement('a');
      a.href = `tel:+${d}`;
      a.textContent = `+${d.slice(0, 2)} ${d.slice(2, 4)} ${d.slice(4, 6)} ${d.slice(6, 8)} ${d.slice(8)}`;
      phone.replaceChildren(a);
    };
    human.forEach((t) => window.addEventListener(t, show, { passive: true }));
  }
</script>
