---
// The frame around every page: head tags, nav, footer.
import '@fontsource-variable/inter';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  active?: 'about' | 'photography' | 'projects' | '';
  navMode?: 'sticky' | 'veil';
  noindex?: boolean;
  // Link preview picture for this page (a path on the site); the site-wide card when left out
  image?: string;
  imageAlt?: string;
}
const { title, description = site.description, active = '', navMode = 'sticky', noindex = false, image = '/assets/social-card.jpg', imageAlt = 'Florian Preis, handwritten on a fogged window over a photograph' } = Astro.props;
// Browser tab: the domain on Home, the page first and the domain after it everywhere else
const fullTitle = title ? `${title} · preis.works` : 'preis.works';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <script is:inline>document.documentElement.classList.add('js')</script>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  {noindex && <meta name="robots" content="noindex">}
  <meta property="og:type" content="website">
  <meta property="og:site_name" content={site.name}>
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={imageAlt}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#f3f2ef">
  <link rel="icon" type="image/svg+xml" href="/brand/favicon.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32.png">
  <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png">
  <link rel="preload" href="/fonts/FlorianHand-Regular.woff2?v=2" as="font" type="font/woff2" crossorigin>
  <slot name="head" />
</head>
<body>
  <a class="skip glass" href="#main">Skip to content</a>
  <Nav active={active} mode={navMode} />
  {Astro.slots.has('lead') ? (
    <>
      <!-- Home: the veil leads; the rest of the page, footer included, is one block at least a screen tall -->
      <slot name="lead" />
      <div class="after-lead"><slot /><Footer /></div>
    </>
  ) : (
    <>
      <slot />
      <Footer />
    </>
  )}
</body>
</html>
