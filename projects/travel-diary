<style>
*, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
html, body { width:100%; height:100%; overflow:hidden; background:#1a3a5c; }
body { font-family:'Helvetica Neue',Helvetica,Arial,sans-serif; cursor:none; }

/* CURSOR */
#cursor {
  position:fixed; width:15px; height:15px; pointer-events:none; z-index:10000;
  transform-origin:center; transform:translate(-50%,-50%) rotate(0deg);
  will-change:transform;
}
#cursor svg { width:100%; height:100%; fill:#fff; stroke:#111; stroke-width:0.8px;
  filter:drop-shadow(0 1px 2px rgba(0,0,0,0.25)); }

/* LOADER */
#loader {
  position:fixed; inset:0; z-index:9000; background:#0d1f35;
  display:flex; flex-direction:column; align-items:center; justify-content:center;
  transition:opacity 0.9s cubic-bezier(0.4,0,0.2,1);
}
#loader.out { opacity:0; pointer-events:none; }
#loader-video { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; opacity:0.42; }
#loader-content {
  position:relative; z-index:1; text-align:center; width:100%; padding:0 24px;
  display:flex; flex-direction:column; align-items:center;
  opacity:0; transform:translateY(14px); transition:opacity 0.7s ease, transform 0.7s ease;
}
#loader-content.show { opacity:1; transform:translateY(0); }
#loader-eyebrow { font-size:11px; font-weight:400; letter-spacing:0.36em; text-transform:uppercase; color:rgba(255,255,255,0.4); margin-bottom:18px; }
#loader-headline { font-size:clamp(30px,5.5vw,60px); font-weight:300; letter-spacing:0.25em; text-transform:uppercase; color:#fff; line-height:1; margin-bottom:44px; }
#loader-track { width:clamp(160px,28vw,260px); height:1px; background:rgba(255,255,255,0.14); }
#loader-bar { height:100%; width:0%; background:rgba(255,255,255,0.75); transition:width 60ms linear; }
#loader-pct { margin-top:13px; font-size:10px; letter-spacing:0.2em; color:rgba(255,255,255,0.32); }

/* TOOLTIP */
#tooltip {
  position:fixed; pointer-events:none; z-index:8000;
  background:#fff; color:#111;
  font-size:10px; font-weight:500; letter-spacing:0.22em; text-transform:uppercase;
  padding:7px 12px; white-space:nowrap;
  opacity:0; transform:translateY(3px);
  transition:opacity 0.1s ease, transform 0.1s ease;
  box-shadow:0 2px 14px rgba(0,0,0,0.1);
}
#tooltip.show { opacity:1; transform:translateY(0); }

/* PANEL */
#panel {
  position:fixed; bottom:32px; left:32px; z-index:1000;
  background:rgba(255,255,255,0.93);
  backdrop-filter:blur(18px) saturate(150%); -webkit-backdrop-filter:blur(18px) saturate(150%);
  border:1px solid rgba(0,0,0,0.07); padding:22px 24px; min-width:196px;
  opacity:0; transform:translateY(6px); transition:opacity 0.5s ease 0.3s, transform 0.5s ease 0.3s;
}
#panel.show { opacity:1; transform:translateY(0); }
.p-count { font-size:30px; font-weight:300; letter-spacing:-0.03em; color:#111; line-height:1; display:flex; align-items:baseline; gap:4px; }
.p-count-num { font-size:30px; }
.p-count-denom { font-size:13px; color:#aaa; font-weight:400; }
.p-count-info { display:inline-flex; align-items:center; justify-content:center; width:11px; height:11px; border-radius:50%; border:1px solid #ccc; font-size:7px; color:#aaa; cursor:default; position:relative; margin-left:2px; line-height:1; flex-shrink:0; }
.p-count-info:hover .p-count-tip { opacity:1; pointer-events:auto; }
.p-count-tip { position:absolute; left:calc(100% + 8px); top:50%; transform:translateY(-50%); width:210px; background:#fff; color:#222; font-size:10px; line-height:1.55; padding:9px 11px; letter-spacing:0.02em; text-transform:none; font-weight:400; opacity:0; pointer-events:none; transition:opacity 0.15s; z-index:100; box-shadow:0 2px 12px rgba(0,0,0,0.1); border:1px solid #e8e8e8; }
.p-label { font-size:9px; font-weight:500; letter-spacing:0.22em; text-transform:uppercase; color:#bbb; margin:4px 0 14px; }
.p-legend { display:flex; flex-direction:row; align-items:center; gap:14px; margin-bottom:12px; }
.legend-row { display:flex; align-items:center; gap:6px; font-size:9px; letter-spacing:0.1em; text-transform:uppercase; color:#888; }
.swatch { width:11px; height:11px; flex-shrink:0; }
.swatch.v { background:#1a2d45; }
.swatch.u { background:#cdd9c5; border:1px solid rgba(0,0,0,0.08); }
.p-divider { height:1px; background:#efefef; margin-bottom:10px; }
.p-zoom { display:flex; gap:1px; }
.z-btn { flex:1; height:26px; border:1px solid #e0e0e0; cursor:none; font-family:inherit; font-size:15px; font-weight:300; display:flex; align-items:center; justify-content:center; transition:background 0.15s, border-color 0.15s; line-height:1; color:#555; background:#fff; }
.z-btn:hover { background:#f5f5f5; border-color:#ccc; }

/* DRAWER */
#drawer {
  position:fixed; top:0; right:0; width:min(380px,100vw); height:100%; z-index:2000;
  background:rgba(255,255,255,0.97);
  backdrop-filter:blur(24px) saturate(160%); -webkit-backdrop-filter:blur(24px) saturate(160%);
  border-left:1px solid rgba(0,0,0,0.06);
  transform:translateX(100%); transition:transform 0.42s cubic-bezier(0.4,0,0.2,1);
  display:flex; flex-direction:column; overflow:hidden;
}
#drawer.open { transform:translateX(0); }
.dh { padding:18px 18px 12px; border-bottom:1px solid #f0f0f0; display:flex; align-items:flex-start; gap:11px; }
.dh-flag { width:36px; height:27px; object-fit:cover; border:1px solid rgba(0,0,0,0.07); flex-shrink:0; margin-top:2px; }
.dh-text { flex:1; min-width:0; }
.dh-name { font-size:14px; font-weight:700; letter-spacing:0.08em; text-transform:uppercase; color:#111; line-height:1.2; margin-bottom:4px; }
.dh-badge { display:inline-block; font-size:8px; font-weight:600; letter-spacing:0.18em; text-transform:uppercase; color:#999; background:#f5f5f5; border:1px solid #eaeaea; padding:3px 7px; }
.dh-close { width:26px; height:26px; background:none; border:none; cursor:none; font-size:19px; line-height:1; color:#ccc; display:flex; align-items:center; justify-content:center; flex-shrink:0; transition:color 0.15s; font-family:inherit; }
.dh-close:hover { color:#111; }
.db { flex:1; overflow-y:auto; padding:14px 18px 40px; }
.db::-webkit-scrollbar { width:2px; }
.db::-webkit-scrollbar-thumb { background:#e0e0e0; }
.stats-table { width:100%; border-collapse:collapse; margin-bottom:16px; }
.stats-table tr td { padding:3px 0; vertical-align:top; line-height:1.4; }
.stats-table tr td:first-child { font-size:8.5px; font-weight:600; letter-spacing:0.14em; text-transform:uppercase; color:#bbb; padding-right:12px; white-space:nowrap; width:1%; padding-top:5px; }
.stats-table tr td:last-child { font-size:12.5px; color:#111; font-weight:400; }
.stat-na { color:#d0d0d0; font-size:12px; }
.hdi-info { display:inline-flex; align-items:center; justify-content:center; width:12px; height:12px; border-radius:50%; border:1px solid #ccc; font-size:7.5px; color:#aaa; cursor:default; position:relative; line-height:1; flex-shrink:0; margin-left:5px; vertical-align:middle; }
.hdi-info:hover .hdi-tip { opacity:1; pointer-events:auto; }
.hdi-tip { position:absolute; right:calc(100% + 8px); top:50%; transform:translateY(-50%); width:200px; background:#fff; color:#222; font-size:10px; line-height:1.55; padding:9px 11px; letter-spacing:0.02em; text-transform:none; font-weight:400; opacity:0; pointer-events:none; transition:opacity 0.15s; z-index:100; box-shadow:0 2px 12px rgba(0,0,0,0.08); border:1px solid #e8e8e8; }
.trips-title { font-size:9px; font-weight:600; letter-spacing:0.24em; text-transform:uppercase; color:#c8c8c8; margin-bottom:8px; padding-bottom:7px; border-bottom:1px solid #f2f2f2; }
.trip { padding:9px 0; border-bottom:1px solid #f6f6f6; }
.trip:last-child { border-bottom:none; }
.trip-date { font-size:9px; font-weight:600; letter-spacing:0.2em; text-transform:uppercase; color:#bbb; margin-bottom:2px; }
.trip-with { font-size:10px; letter-spacing:0.08em; color:#c5c5c5; margin-bottom:3px; }
.trip-with strong { color:#888; font-weight:400; }
.trip-note { font-size:12.5px; line-height:1.65; color:#444; }
.db-empty { font-size:11px; color:#d0d0d0; letter-spacing:0.1em; padding:8px 0; font-style:italic; }
.not-visited { font-size:11px; letter-spacing:0.2em; text-transform:uppercase; color:#d0d0d0; padding:8px 0; }
.stats-source { font-size:8px; letter-spacing:0.12em; text-transform:uppercase; color:#d0d0d0; margin-bottom:16px; margin-top:-8px; }

/* MAP */
#map { position:absolute; inset:0; }
.mapboxgl-ctrl-logo { display:none !important; }
.mapboxgl-ctrl-attrib { font-size:9px !important; opacity:0.5; }

@media (max-width:640px) {
  #panel { bottom:20px; left:20px; padding:18px 20px; min-width:172px; }
  #drawer { width:100vw; }
}
@media (hover:none) { body { cursor:auto; } #cursor { display:none; } }
@media (prefers-reduced-motion:reduce) { *, *::before, *::after { transition-duration:0.01ms !important; } }
</style>
