  // Hover highlight — separate layer using feature-state
  map.addLayer({
    id: 'countries-hover',
    type: 'fill',
    source: 'countries',
    'source-layer': 'country_boundaries',
    paint: {
      'fill-color': 'rgba(60, 100, 160, 0.55)',
      'fill-opacity': [
        'case',
        ['boolean', ['feature-state', 'hover'], false],
        1,
        0
      ]
